{
  "name": "bay",
  "private": true,
  "scripts": {
    "dev": "XDG_CONFIG_HOME=$PWD/.wrangler/xdg WRANGLER_LOG_PATH=$PWD/.wrangler/logs wrangler dev --ip 0.0.0.0",
    "dev:test": "XDG_CONFIG_HOME=$PWD/.wrangler/xdg WRANGLER_LOG_PATH=$PWD/.wrangler/logs wrangler dev --port 8788 --persist-to .wrangler/test-state",
    "deploy": "wrangler deploy",
    "build:scratch": "bun scripts/build-app.ts scratch",
    "build:notes": "bun scripts/build-app.ts notes",
    "build:flashcards": "bun scripts/build-app.ts flashcards",
    "build:backup": "bun scripts/build-app.ts backup"
  },
  "dependencies": {
    "@garage/sync": "workspace:*",
    "lib0": "0.2.117",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "wrangler": "4.127.1"
  }
}
